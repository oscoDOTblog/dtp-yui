# Host defaults for `npm start`.
# Copy: cp .env.example .env
# Compose / shell exports win when already set (this file does not override them).

# 0 = headed browser window (default). Copilot live preview still works.
#     Click/type in the window to auto-pause the agent (Take control).
# 1 = headless only — preview in /copilot, no OS window.
CV_AGENT_HEADLESS=0

# Browser engine: chromium | firefox
CV_AGENT_BROWSER=chromium
# System Google Chrome (not Playwright's Chrome for Testing)
CV_AGENT_BROWSER_CHANNEL=chrome
# Optional override (macOS checks /Applications then ~/Applications)
# CV_AGENT_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Keep sandbox on — avoids --no-sandbox yellow bar / Cloudflare fingerprint
CV_AGENT_CHROMIUM_SANDBOX=1
# Alternate: CV_AGENT_BROWSER=firefox (Playwright's patched Firefox build)

# FastAPI base URL from the host. Use http://api:8000 inside Compose.
CV_API_BASE=http://127.0.0.1:8000

# Agent control plane (HTTP / SSE / WS).
CV_AGENT_PORT=8010

# Glassdoor search + caps (preferRemote, searchUrl, …).
CV_AGENT_CONFIG=../../config/agent.json

# Where generate-package writes resume.pdf (must match API volume on host).
GENERATED_APPLICATIONS_DIR=../../generated-applications

# Live preview for Apply Copilot (JPEG via GET /preview/latest). 0 to disable.
CV_AGENT_PREVIEW=1

# Max preview width in pixels (keeps bandwidth modest).
CV_AGENT_PREVIEW_MAX_WIDTH=960
