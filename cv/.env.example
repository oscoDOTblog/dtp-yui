# MongoDB
# Local compose still uses the mongodb service below.
# Atlas: set MONGO_URI to your mongodb+srv://… string and MONGO_DB=DTP
# (CV collections are all prefixed cv_ inside database DTP.)
MONGO_ROOT_USERNAME=cvadmin
MONGO_ROOT_PASSWORD=change-me-local
MONGO_DB=DTP
MONGO_URI=mongodb://cvadmin:change-me-local@mongodb:27017/DTP?authSource=admin

# Ollama (host service; Docker uses host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Thinking mode is a Settings toggle (ollama.think), default false

# Matching thresholds
SCORE_URGENT=70
SCORE_DIGEST=50

# Paths
GENERATED_APPLICATIONS_DIR=/app/generated-applications
SEED_DIR=/app/seed

# OpenAI (optional — Settings → Document generation)
# Place key in secrets/openai-api-key, or set OPENAI_API_KEY below.
# Cover letter + resume tailor only; other LLM calls stay on Ollama.
# Model is chosen in the Settings UI; OPENAI_MODEL is only the initial default.
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/app/secrets/openai-api-key
# Optional admin key — enables the org-wide daily token usage bar in Settings.
# Create at https://platform.openai.com/settings/organization/admin-keys
# Without it, the bar counts only tokens this app spent.
# OPENAI_ADMIN_API_KEY=
# OPENAI_ADMIN_API_KEY_FILE=/app/secrets/openai-admin-key

# CORS / web
# WEB_HOST_PORT is the published UI port (default 7545) so multiple apps can
# share one host without fighting over :80/:3000.
# Leave NEXT_PUBLIC_API_BASE empty to use the same-origin /backend proxy.
WEB_HOST_PORT=7545
CORS_ORIGINS=http://localhost:7545,http://127.0.0.1:7545
NEXT_PUBLIC_API_BASE=
API_BASE_INTERNAL=http://api:8000

# Candidate profile version bump when seed changes
PROFILE_VERSION=1

# Stage 2A — Gmail ingest (see docs/GMAIL_SETUP.md)
SECRETS_DIR=/app/secrets
LOCATION_CONFIG=/app/config/location.json
ROLE_FILTER_CONFIG=/app/config/roleFilter.json
GMAIL_QUERY=label:JobAlerts newer_than:2d
GMAIL_PROCESSED_LABEL=false
INGEST_ON_START=true
# Cap listings processed per ingest run when AUTO_PROCESSING_ENABLED=true
INGEST_MAX_LISTINGS=500

# When AUTO_PROCESSING_ENABLED=false, manual Inbox Fetch / API run with no
# maxListings uses this many listings *per active source* (not a shared total).
INGEST_MANUAL_PER_SOURCE=10

# Greenhouse / Ashby / Remotive: keep postings with postedAt within this many days.
# Missing postedAt is kept (unknown age). Unprocessed listings are ordered first.
INGEST_BOARD_LOOKBACK_DAYS=14

# Host role — automatic background processing (worker cron + on-start ingest/scan).
# Laptop sharing Atlas/Mongo with a remote processor: set false so hourly jobs
# only run on the remote host. Analyze / generate docs / manual Run ingest still work.
# Remote processor: true (default) or omit.
AUTO_PROCESSING_ENABLED=true

# Telegram (same names as osco-dot-blog) — alert when recommendation=apply
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stage 4 — GitHub evidence (see docs/GITHUB_SETUP.md)
# Place PAT in secrets/github-token (or set GITHUB_TOKEN / GITHUB_TOKEN_FILE)
# GITHUB_TOKEN_FILE=/app/secrets/github-token
# GITHUB_TOKEN=
GITHUB_SCAN_ON_START=false
REPOSITORY_CACHE_DIR=/app/repository-cache

# Stage 6 — Apply agent (Playwright)
# Default: run agent on the host (`cd services/agent && npm start`) so Chromium can pop up.
# Web (in Docker) proxies to the host agent:
AGENT_BASE_INTERNAL=http://host.docker.internal:8010
# Host `npm start` uses services/agent/.env (headed + preview by default).
# Opt-in container agent (headless, no popup):
#   docker compose --profile headless-agent up -d agent
#   then set AGENT_BASE_INTERNAL=http://agent:8010 and recreate web.
CV_AGENT_HEADLESS=1
CV_API_BASE=http://api:8000
